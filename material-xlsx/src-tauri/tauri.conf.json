{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Xlsx",
  "version": "1.2.0",
  "identifier": "com.minhtrong67.materialxlsx",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Material Xlsx",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "© minhtrong67",
    "category": "Productivity",
    "shortDescription": "A simple, modern spreadsheet editor for .xlsx files",
    "longDescription": "Material Xlsx is a lightweight spreadsheet editor with a Material Design 3 interface, formulas, formatting, themes and English / Vietnamese support. Created by minhtrong67 with the support of Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "xlsx"
        ],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "Delimited text",
        "description": "CSV / TSV",
        "role": "Editor"
      }
    ]
  }
}
