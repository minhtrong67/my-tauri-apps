{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Ico",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.materialico",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Material Ico",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Graphics and Design",
    "shortDescription": "Simple Icon File Maker",
    "longDescription": "Create .ico files from images and SVGs and use them as folder icons in Windows 10/11.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/uninstall.ico": "icons/uninstall.ico"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}