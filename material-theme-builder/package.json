    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
