{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Folder Icon",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.fluentfoldericon",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fluent Folder Icon",
        "width": 1320,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Change folder icons and colors on Windows 11 and 10",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
