{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP3 Downloader",
  "version": "0.4.0",
  "identifier": "com.myproject.mp3downloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MP3 Downloader",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "minhtrong67",
    "copyright": "© 2026 minhtrong67",
    "category": "Music",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Download MP3 from YouTube, TikTok and Spotify",
    "longDescription": "MP3 Downloader saves music from YouTube, TikTok and Spotify links as MP3 files with cover art, artist, album and year embedded.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico"
      }
    }
  }
}
