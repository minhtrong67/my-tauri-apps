{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material File",
  "version": "1.1.0",
  "identifier": "com.minhtrong67.material-file",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "tsc --noEmit && vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material File",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; frame-src asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Utility",
    "shortDescription": "Simple, fast file manager with Material Design 3.",
    "longDescription": "Material File is a lightweight file manager with Material Design 3 Expressive: quick access, drives, details and icon views, dual pane, tabs, tags, duplicate finder, disk usage map, command palette, themes and English/Vietnamese support. Created by minhtrong67 with the support of Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer/installer.ico",
        "uninstallerIcon": "icons/installer/uninstall.ico",
        "uninstallerHeaderImage": "icons/installer/nsis-header-uninstall.bmp",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "installerHooks": "icons/installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}
