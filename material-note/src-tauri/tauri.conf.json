{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Note",
  "version": "2.0.0",
  "identifier": "com.minhtrong67.material-note",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material Note",
        "width": 1120,
        "height": 740,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "backgroundColor": "#fef7ff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Productivity",
    "shortDescription": "Fast, expressive notepad in Material 3 Expressive style.",
    "longDescription": "Material Note is a fast, tabbed notepad with find & replace, command palette, encodings, themes, custom colors and English/Vietnamese support. Created by minhtrong67 with the support of Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "log",
          "md",
          "json",
          "csv",
          "ini",
          "yml",
          "yaml",
          "toml",
          "xml"
        ],
        "name": "Text document",
        "description": "Plain text document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer/installer.ico",
        "uninstallerIcon": "icons/installer/uninstall.ico",
        "uninstallerHeaderImage": "icons/installer/nsis-header-uninstall.bmp",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installMode": "currentUser"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}