{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Readme",
  "version": "2.0.0",
  "identifier": "com.minhtrong67.materialreadme",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Material Readme",
        "width": 1240,
        "height": 820,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Productivity",
    "shortDescription": "Material Design Markdown editor and viewer",
    "longDescription": "Material Readme is a Material Design 3 desktop app to read, write and live-preview Markdown files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": ["English", "Vietnamese"]
      }
    }
  }
}
