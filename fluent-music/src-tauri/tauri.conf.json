{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Music",
  "version": "2.0.0",
  "identifier": "com.minhtrong67.fluent-music",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fluent Music",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Fluent Design music player for Windows",
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "opus",
          "m4a",
          "aac"
        ],
        "name": "Audio file",
        "description": "Audio file",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "longDescription": "A local music player with a Fluent Design (Windows 11) interface, Mica / Acrylic window materials, English and Vietnamese UI, themes, equalizer, lyrics and playlists.",
    "publisher": "minhtrong67",
    "category": "Music",
    "copyright": "Copyright (c) 2026 minhtrong67 - MIT License"
  }
}
