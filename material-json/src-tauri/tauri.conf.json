{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material JSON",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.material-json",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material JSON",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "DeveloperTool",
    "shortDescription": "A full-featured JSON editor and toolbox",
    "longDescription": "Material JSON is an open-source JSON editor with tree view, JSONPath queries, diff, schema validation and format converters, designed with Material Design 3.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json", "jsonc"],
        "name": "JSON Document",
        "description": "JSON Document",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "icons/nsis-uninstaller-header.bmp",
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": false
      }
    }
  }
}
