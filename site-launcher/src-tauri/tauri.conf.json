{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Site Launcher",
  "version": "0.1.0",
  "identifier": "dev.minhtrong67.site-launcher",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Site Launcher",
        "width": 920,
        "height": 700,
        "minWidth": 540,
        "minHeight": 540,
        "center": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Utility",
    "shortDescription": "Open browser profiles with the websites you choose",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/nsis-uninstall-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
