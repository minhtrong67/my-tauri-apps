{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Video",
  "version": "1.2.0",
  "identifier": "com.minhtrong67.fluent-video",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fluent Video",
        "width": 1280,
        "height": 780,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=PlatformHEVCDecoderSupport --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Fluent Design video player",
    "longDescription": "Fluent Video is a full-featured video player for Windows with a Microsoft Fluent Design interface and Mica / Acrylic window materials.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "ogv"
        ],
        "name": "Video file",
        "description": "Video file",
        "role": "Viewer"
      }
    ]
  }
}
