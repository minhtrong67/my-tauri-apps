{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Music",
  "version": "1.2.0",
  "identifier": "com.minhtrong67.material-music-player",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420/app.html",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material Music",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Material Design 3 music player for Windows",
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "opus",
          "m4a",
          "aac"
        ],
        "name": "Audio file",
        "description": "Audio file",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "longDescription": "A beautiful local music player with a Material Design 3 interface, English and Vietnamese UI, themes, equalizer, lyrics and playlists.",
    "publisher": "minhtrong67",
    "category": "Music",
    "copyright": "Copyright (c) 2026 minhtrong67 - MIT License"
  },
  "plugins": {
    "updater": {
      "pubkey": "PASTE_YOUR_PUBLIC_KEY_HERE - see README, section Auto-update",
      "endpoints": [
        "https://material-music-player-delta.vercel.app/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
