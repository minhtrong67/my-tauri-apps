{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Video Downloader",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "minhtrong67",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Material Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["webRequest", "storage", "tabs", "cookies", "downloads", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"]
}
