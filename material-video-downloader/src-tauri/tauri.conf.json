{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Video Downloader",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.materialvideodownloader",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material Video Downloader",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Utility",
    "shortDescription": "Download videos from the web, fast.",
    "longDescription": "Material Video Downloader is a Material Design 3 desktop app that downloads videos from hundreds of sites, with segmented downloads, HLS support and a companion Chrome extension.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English", "Vietnamese"],
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
