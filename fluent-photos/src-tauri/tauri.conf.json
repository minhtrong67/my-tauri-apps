{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Photos",
  "version": "2.0.0",
  "identifier": "com.minhtrong67.materialphoto",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web -- build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fluent Photos",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; script-src 'self' 'unsafe-inline' http://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:1420 http://127.0.0.1:1420 ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$PICTURE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "shortDescription": "View and edit your pictures",
    "longDescription": "Fluent Photos is a fast photo viewer and editor with a Microsoft Fluent Design interface (Mica and Acrylic).",
    "category": "Photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "jfif",
          "gif",
          "webp",
          "bmp",
          "ico",
          "avif"
        ],
        "name": "Image",
        "description": "Picture",
        "role": "Viewer",
        "mimeType": "image/png"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "installer/setup.ico",
        "uninstallerIcon": "installer/uninstall.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}