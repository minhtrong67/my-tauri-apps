{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Menu",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.materialmenu",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Material Menu",
        "url": "app.html",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Utility",
    "shortDescription": "Customize the Windows 11 right-click menu",
    "longDescription": "Material Menu lets you add custom commands, hide items and switch between the compact and classic Windows 11 context menu.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerHeaderImage": "icons/uninstaller-header.bmp"
      }
    }
  }
}
