{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Image",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.code-image",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Image",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "© 2026 minhtrong67 · MIT License",
    "shortDescription": "Turn your code into beautiful images",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Vietnamese"]
      }
    }
  }
}
